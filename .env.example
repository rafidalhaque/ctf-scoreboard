# CTFd Configuration
CTFD_EVENT_NAME=CTF Event Name
CTFD_API_URL=https://your-ctfd-instance.com/api/v1
CTFD_API_KEY=your_ctfd_api_key_here

# Refresh interval in seconds (default: 60 seconds = 1 minute)
REFRESH_INTERVAL=60

# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Optional: Number of top teams to display (default: 10)
TOP_TEAMS_COUNT=10

# CTF Start Time Configuration (for countdown landing page)
# Format: YYYY-MM-DD HH:MM:SS (24-hour format, server's local timezone)
# If not set or time has passed, scoreboard will be shown directly
# Note: Ensure server timezone is configured correctly (e.g., set TZ environment variable)
CTF_START_TIME=2025-12-31 00:00:00

# Freeze Mode Configuration
# When set to true, scoreboard will stop fetching from CTFd API and serve from database only
# Use this when you want to freeze the standings (e.g., at the end of the competition)
FREEZE_MODE=false
